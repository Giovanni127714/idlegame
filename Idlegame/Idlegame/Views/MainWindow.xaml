<Window x:Class="Idlegame.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Idlegame.ViewModels"
        mc:Ignorable="d"
        Title="Idlegame" Height="650" Width="1280"
        MinHeight="500" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- HUD -->
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="💰" FontSize="28" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding CurrencyDisplay}" Style="{StaticResource CurrencyText}" HorizontalAlignment="Center" />
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0">
                    <Run Text="📈 " />
                    <Run Text="{Binding IncomePerSecondDisplay, Mode=OneWay}" />
                    <Run Text=" / sec" />
                </TextBlock>

                <Button Command="{Binding ClickCommand}"
                        Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,24,0,0">
                    <TextBlock>
                        <Run Text="⚡ Klik om te produceren (+" />
                        <Run Text="{Binding ClickValueDisplay, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                </Button>

                <Button Command="{Binding SaveCommand}"
                        Content="💾 Opslaan"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,10,0,0" />
                <TextBlock Text="{Binding LastSavedDisplay}"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />

                <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource PurpleBrush}" Margin="0,28,0,0">
                    <StackPanel>
                        <TextBlock Text="⭐ Prestige" Style="{StaticResource ItemTitle}" Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" FontSize="16" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyText}" FontSize="12" Margin="0,8,0,0">
                            <Run Text="Sterren: " />
                            <Run Text="{Binding PrestigePointsDisplay, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="  |  Bonus: " />
                            <Run Text="{Binding PrestigeMultiplierDisplay, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,2,0,0">
                            <Run Text="Beschikbaar bij prestige: +" />
                            <Run Text="{Binding PrestigeAvailableDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <Button Command="{Binding PrestigeCommand}"
                                Content="Prestige"
                                Style="{StaticResource PrestigeButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Upgrades -->
        <DockPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="⚡ Upgrades" Style="{StaticResource SectionHeader}" Foreground="{StaticResource BlueBrush}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Upgrades}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource ItemDescription}" />
                                        <TextBlock Style="{StaticResource ItemMeta}">
                                            <Run Text="💰 " />
                                            <Run Text="{Binding CostDisplay, Mode=OneWay}" />
                                            <Run Text="   ⚡ " />
                                            <Run Text="{Binding EffectDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Koop"
                                            Command="{Binding BuyCommand}"
                                            Style="{StaticResource BuyButton}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Koop {0}'}"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Automatiseringen + Log -->
        <DockPanel Grid.Column="2" Margin="20,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="🤖 Automatiseringen" Style="{StaticResource SectionHeader}" Foreground="{StaticResource TealBrush}" />
            <ScrollViewer DockPanel.Dock="Top" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Automations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource ItemDescription}" />
                                        <TextBlock Style="{StaticResource ItemMeta}">
                                            <Run Text="💰 " />
                                            <Run Text="{Binding CostDisplay, Mode=OneWay}" />
                                            <Run Text="   🤖 " />
                                            <Run Text="{Binding ProductionDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Koop"
                                            Command="{Binding BuyCommand}"
                                            Style="{StaticResource BuyButton}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Koop {0}'}"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock DockPanel.Dock="Top" Text="📜 Log" Style="{StaticResource SectionHeader}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" Margin="0,20,0,10" />
            <Border Style="{StaticResource PanelBorder}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontFamily="Consolas" Margin="0,0,0,3" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Winkel -->
        <DockPanel Grid.Column="3" Margin="20,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="🏪 Winkel" Style="{StaticResource SectionHeader}" Foreground="{StaticResource OrangeBrush}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ShopItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                            <Border Background="{StaticResource OrangeBrush}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Quantity}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource ItemDescription}" />
                                        <TextBlock Style="{StaticResource ItemMeta}">
                                            <Run Text="💰 " />
                                            <Run Text="{Binding CostDisplay, Mode=OneWay}" />
                                            <Run Text="   🏪 " />
                                            <Run Text="{Binding ProductionDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Koop"
                                            Command="{Binding BuyCommand}"
                                            Style="{StaticResource BuyButton}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Koop {0}'}"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
